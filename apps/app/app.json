{
  "expo": {
    "name": "Forkbell",
    "slug": "forkbell",
    "scheme": "forkbell",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.realxero.forkbell",
      "supportsTablet": true
    },
    "android": {
      "package": "com.realxero.forkbell"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Forkbell uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
