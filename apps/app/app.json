{
  "expo": {
    "name": "Forkbell",
    "slug": "forkbell",
    "scheme": "forkbell",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.realxero.forkbell",
      "supportsTablet": true
    },
    "android": {
      "package": "com.realxero.forkbell",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_EXERCISE"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Forkbell uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Forkbell reads your steps, activity, resting heart rate and weight to show your progress.",
          "NSHealthUpdateUsageDescription": "Forkbell saves your daily calories, macros and workouts to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
