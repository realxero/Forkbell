{
  "name": "@forkbell/server",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "build": "esbuild src/index.ts ../../packages/db/src/migrate.ts --bundle --platform=node --format=esm --target=node22 --external:hono --external:@hono/node-server --external:drizzle-orm --external:openid-client --external:postgres --external:zod --outdir=dist --entry-names=[name]",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:api": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@forkbell/db": "workspace:*",
    "@forkbell/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  }
}
