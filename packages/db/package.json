{
  "name": "@forkbell/db",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "rls-check": "node --env-file-if-exists=../../.env --import tsx src/rls-check.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "@forkbell/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.23.15",
    "@types/node": "^22.0.0"
  }
}
