# --- Postgres -------------------------------------------------------------
# Admin account: only the one-shot migrate container uses it.
POSTGRES_PASSWORD=change-me-admin
# Limited account the server runs as. It cannot bypass row-level security.
APP_DB_PASSWORD=change-me-app

# --- Server ---------------------------------------------------------------
# The address people open Forkbell at (no trailing slash).
PUBLIC_URL=https://forkbell.example.com
# 32+ random bytes: openssl rand -base64 48
SESSION_SECRET=change-me

# --- Sign-in ---------------------------------------------------------------
# Turn on at least one: single sign-on, passwords, or both.
#
# Single sign-on with Authelia, or any OpenID Connect provider (Authentik,
# Pocket ID, Keycloak, Zitadel, Google...). Leave OIDC_ISSUER empty to turn it off.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=forkbell
OIDC_CLIENT_SECRET=change-me
# What the sign-in button says: "Sign in with Authelia".
OIDC_NAME=Authelia
#
# Username and password, for people who don't use the single sign-on.
# on or off. Off by default when single sign-on is set, on when it isn't.
PASSWORD_LOGIN=
# Who can make a new password account:
#   off   only people who already have an account (they add a password in
#         Settings → Sign-in and security). A server with no accounts yet lets
#         the first person sign up.
#   code  anyone with SIGNUP_CODE (8+ characters; share it with your family)
#   open  anyone who can reach the server
PASSWORD_SIGNUP=off
SIGNUP_CODE=

# --- Food search (optional) -----------------------------------------------
# Free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# --- Exercise pictures (optional) ------------------------------------------
# The server fetches each how-to picture once and keeps a copy. Point this at a
# mounted folder to keep the copies across updates; by default they go in a
# temporary folder and are simply fetched again when needed. With it set, the
# server also fetches the whole set (about 90 MB) once in the background.
# PREFETCH_PICTURES=off turns that off.
MEDIA_DIR=

# --- Bell, the assistant (optional) ----------------------------------------
# anthropic, or openai for OpenAI and anything OpenAI-compatible (Ollama,
# LM Studio, OpenRouter, Gemini's OpenAI endpoint). Leave empty to turn Bell off.
AI_PROVIDER=
AI_API_KEY=
# e.g. claude-sonnet-5-5, gpt-..., llama3.2-vision. Photo logging needs a vision model.
AI_MODEL=
# Only for OpenAI-compatible servers, e.g. http://192.168.1.20:11434/v1 for Ollama.
AI_BASE_URL=
# Each person can also add their own key in Settings → Bell (Gemini, Anthropic,
# OpenAI). Set this to true to also allow "your own server" addresses there,
# e.g. Ollama on your network. Off by default: it lets the server fetch any URL.
AI_ALLOW_CUSTOM_URL=

# --- Bell's voice (optional) ----------------------------------------------
# A natural voice from an OpenAI-compatible speech server, such as
# Kokoro-FastAPI on a computer with a GPU on your network. Leave empty and the
# app uses the phone's best voice (download a Premium one in iOS Settings →
# Accessibility → Spoken Content → Voices).
TTS_BASE_URL=
# e.g. http://192.168.1.20:8880/v1
TTS_VOICE=af_heart
TTS_MODEL=kokoro
# Only if your speech server wants a key.
TTS_API_KEY=

# --- Development only -----------------------------------------------------
# DATABASE_ADMIN_URL=postgres://forkbell_admin:change-me-admin@localhost:5432/forkbell
# DATABASE_URL=postgres://forkbell_app:change-me-app@localhost:5432/forkbell
# PUBLIC_URL=http://localhost:3000
# APP_URL=http://localhost:8081
# The app reads its own env file: put this line in apps/app/.env instead.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: let Bell search the web, e.g. for a restaurant's published
# nutrition ("Peet's croissant grilled cheese"). Point it at a SearXNG
# instance with the JSON format turned on (search.formats: [html, json] in
# its settings.yml). Only Bell's search words leave your server, to SearXNG.
SEARCH_URL=

# Optional: import recipes from your Mealie by pasting a recipe's link
# (Recipes → Import a recipe). MEALIE_URL is how the Forkbell server reaches
# Mealie; MEALIE_TOKEN an API token from your Mealie profile (needed unless
# your recipes are public).
MEALIE_URL=
MEALIE_TOKEN=
